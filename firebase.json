{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/api/enviarNotificacion",   "function": "enviarNotificacion",   "region": "us-central1" },
      { "source": "/api/generarLinkFirma",     "function": "generarLinkFirma",     "region": "us-central1" },
      { "source": "/api/procesarFirmaCliente", "function": "procesarFirmaCliente", "region": "us-central1" },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}